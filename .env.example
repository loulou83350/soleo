# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***
# Optional: fallback personal access token (dev only — OAuth is preferred)
FIGMA_ACCESS_TOKEN=

# Figma OAuth app credentials (figma.com/developers/apps)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Same Client ID, exposed publicly — used as `client-id` query param in the
# Figma Embed Kit iframe URL to enable postMessage events (PRESENTED_NODE_CHANGED).
# Required for prototype-task auto-completion. Origins must be whitelisted in
# the app's "Embed API → Allowed embed origins" config on figma.com.
NEXT_PUBLIC_FIGMA_CLIENT_ID=

# ─── Story 5.3 — AI insight tagging ─────────────────────────────────────────
# At least one of ANTHROPIC_API_KEY or GEMINI_API_KEY must be set to enable
# the "Suggest tags" button + auto-tagging.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional — override the default OpenAI model (gpt-4o-mini is the default,
# good balance of quality and cost). Use 'gpt-4o' for higher quality.
OPENAI_MODEL=
# Default provider when multiple keys are present. Per-call override possible
# via UI toggle. Allowed: anthropic | gemini | openai
AI_PROVIDER=anthropic

# ─── PostHog (analytics + session recording) ───────────────────────────────
# Project API key from posthog.com → Settings → Project. EU region recommended
# for RGPD. Active only on /dashboard/* — never on /s/* or /findings/* routes.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# ─── AI Feature Flags ───────────────────────────────────────────────────────
# Each AI feature can be turned on/off independently. Defaults: ON when at
# least one provider key (OPENAI/ANTHROPIC/GEMINI_API_KEY) is configured,
# except AI_AUTO_TAG which is OFF by default (opt-in to avoid surprise costs).
# Accepted values: 'true' / 'false' / '1' / '0'. Empty or unset = default.

# Manual "Suggérer" button on each response in the dashboard (Story 5.3 manual)
NEXT_PUBLIC_AI_TAG_SUGGEST=true
# "✨ Suggérer brouillon IA" button on the findings editor (Story 6.1)
NEXT_PUBLIC_AI_FINDINGS=true
# AI follow-up question after a participant answers an open-text block (Epic 7)
NEXT_PUBLIC_AI_FOLLOWUP=true
# Auto-tag every new response on save (Story 5.3 auto). Off by default.
AI_AUTO_TAG=false

# ─── AI usage tracking ──────────────────────────────────────────────────────
# Logging into ai_usage_logs runs unconditionally server-side. This flag only
# controls whether the "Utilisation IA" card is rendered in /dashboard/general.
# Off by default — analyses are done outside the platform for now.
NEXT_PUBLIC_SHOW_AI_USAGE_UI=false